# Second Brain React Native App - Environment Variables
# Copy this file to .env and fill in your values

# API Base URL (no trailing slash, include /api)
# Must use EXPO_PUBLIC_ prefix to be accessible in the app
EXPO_PUBLIC_API_BASE_URL=https://your-server-url.com/api

# Google SSO OAuth client IDs (public values, not secrets).
# Sign-in uses the native Google Sign-In SDK (@react-native-google-signin/google-signin).
# - WEB client id is passed as the SDK's webClientId; the returned id_token's audience is the
#   Web client, so the backend (GOOGLE_SSO_CLIENT_ID) must list this Web client id.
# - ANDROID client (package + SHA-1) authorizes the sign-in on Android.
# - IOS client is used on iOS builds.
# Create all three OAuth clients in Google Cloud Console.
# NOTE: EAS cloud builds do NOT read this local .env — set these as EAS env vars
#       (eas env:create ... --visibility plaintext) or in eas.json for cloud builds.
EXPO_PUBLIC_GOOGLE_SSO_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_SSO_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_SSO_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
